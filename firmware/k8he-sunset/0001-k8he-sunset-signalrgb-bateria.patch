+
+    [WIN_FN] = LAYOUT_ansi_87(
+        _______,            KC_BRID,  KC_BRIU,  KC_TASK,  KC_FILE,  UG_VALD,  UG_VALU,  KC_MPRV,  KC_MPLY,  KC_MNXT,  KC_MUTE,  KC_VOLD,  KC_VOLU,   _______,  _______,  UG_TOGG,
+        _______,  BT_HST1,  BT_HST2,  BT_HST3,  P2P4G,    _______,  _______,  _______,  _______,  _______,  _______,  _______,  _______,  _______,   _______,  _______,  _______,
+        UG_TOGG,  UG_NEXT,  UG_VALU,  UG_HUEU,  UG_SATU,  UG_SPDU,  _______,  _______,  _______,  _______,  _______,  _______,  _______,  _______,   _______,  _______,  _______,
+        _______,  UG_PREV,  UG_VALD,  UG_HUED,  UG_SATD,  UG_SPDD,  _______,  _______,  _______,  _______,  _______,  _______,            _______,
+        _______,            _______,  _______,  _______,  _______,  BAT_LVL,  _______,  _______,  _______,  _______,  _______,            _______,             _______,
+        _______,  _______,  _______,                                _______,                                _______,  _______,  _______,  _______,   _______,  _______,  _______)
+};
+// clang-format on
+
+// Fn + Backspace -> salta directo al efecto Sunset Wave
+bool process_record_user(uint16_t keycode, keyrecord_t *record) {
+    if (keycode == KC_BSPC && (IS_LAYER_ON(MAC_FN) || IS_LAYER_ON(WIN_FN))) {
+        if (record->event.pressed) {
+            rgb_matrix_enable();
+            rgb_matrix_mode(RGB_MATRIX_CUSTOM_SUNSET_WAVE);
+        }
+        return false;
+    }
+    return true;
+}
+
+// Comandos raw HID propios: se atienden antes que los de Keychron y VIA.
+bool kc_raw_hid_rx_user(uint8_t src, uint8_t *data, uint8_t length) {
+    if (battery_hid_rx(src, data, length)) return true;
+    if (signalrgb_rx(src, data, length)) return true;
+    return false;
+}
diff --git a/keyboards/keychron/k8_he/ansi/keymaps/sunset/rgb_matrix_user.inc b/keyboards/keychron/k8_he/ansi/keymaps/sunset/rgb_matrix_user.inc
new file mode 100644
index 0000000..720f17d
--- /dev/null
+++ b/keyboards/keychron/k8_he/ansi/keymaps/sunset/rgb_matrix_user.inc
@@ -0,0 +1,117 @@
+/* Sunset Wave — efecto custom para Keychron K8 HE
+ *
+ * Una ola de degradé estilo "Arco iris" de Aura Sync, pero con una paleta de
+ * atardecer: amarillo -> naranja -> rosa -> magenta -> violeta (y vuelta),
+ * con un tramo violeta más largo y un toque pastel para que no sature.
+ *
+ * Controles (los mismos de siempre, en la capa Fn):
+ *   Fn + W / Fn + S  -> brillo
+ *   Fn + T / Fn + G  -> velocidad de la ola
+ *   Fn + R / Fn + F  -> saturación: bajarla (Fn + F) lo hace MÁS pastel
+ *   Fn + E / Fn + D  -> (sin uso en este efecto)
+ *
+ * Todo lo que se puede tunear está en la sección "AJUSTES".
+ */
+
+RGB_MATRIX_EFFECT(SUNSET_WAVE)
+
+/* Modo SignalRGB: no dibuja nada, los colores los manda SignalRGB por raw HID. */
+RGB_MATRIX_EFFECT(SIGNALRGB)
+
+#ifdef RGB_MATRIX_CUSTOM_EFFECT_IMPLS
+
+/* ========================= AJUSTES ========================= */
+
+/* Paleta. Va de izquierda a derecha y después vuelve (ida y vuelta), así la
+ * ola no tiene un "corte" brusco entre violeta y amarillo.
+ * Los valores están corregidos para LEDs: en un LED el verde pesa mucho, por
+ * eso el amarillo tiene menos verde que en pantalla (si no se ve lima). */
+static const uint8_t SW_PALETTE[][3] = {
+    {255, 175,  25}, // amarillo
+    {255, 105,  15}, // naranja
+    {255,  35,  95}, // rosa
+    {215,  15, 185}, // magenta
+    {150,  25, 255}, // violeta
+    {125,  35, 255}, // violeta profundo  (repetido = más violeta en la ola)
+    {215,  15, 185}, // magenta
+    {255,  35,  95}, // rosa
+    {255, 105,  15}, // naranja
+};
+
+/* Blanco cálido hacia el que se "lava" el color para hacerlo pastel.
+ * El blanco puro (255,255,255) en LEDs suele verse azulado. */
+#define SW_WHITE_R 255
+#define SW_WHITE_G 215
+#define SW_WHITE_B 200
+
+/* Cuánto pastel (0 = color puro, 255 = blanco).
+ * BASE es lo que tenés con la saturación al máximo; bajando la saturación
+ * con Fn + F se va acercando a MAX. */
+#define SW_PASTEL_BASE 55
+#define SW_PASTEL_MAX 190
+
+/* Qué parte del ciclo de colores entra a lo ancho del teclado.
+ * Más alto = franjas más angostas (se ven más colores a la vez). */
+#define SW_SPREAD 175
+
+/* Leve inclinación diagonal de la ola (0 = franjas verticales). */
+#define SW_TILT 40
+
+/* 1 = la ola viaja hacia la derecha, 0 = hacia la izquierda. */
+#define SW_LEFT_TO_RIGHT 1
+
+/* =========================================================== */
+
+#define SW_STOPS (sizeof(SW_PALETTE) / sizeof(SW_PALETTE[0]))
+
+static inline uint8_t sw_lerp8(uint8_t a, uint8_t b, uint8_t frac) {
+    return (uint8_t)(a + (((int16_t)b - (int16_t)a) * (int16_t)frac) / 255);
+}
+
+static bool SUNSET_WAVE(effect_params_t *params) {
+    RGB_MATRIX_USE_LIMITS(led_min, led_max);
+
+    /* Tiempo -> fase de la ola. A velocidad media (127) un ciclo completo
+     * tarda ~8 s; a velocidad máxima ~4 s; a mínima ~65 s. */
+    uint16_t t = (uint16_t)(g_rgb_timer * (uint32_t)((rgb_matrix_config.speed >> 4) + 1));
+
+    /* Pastel: mezcla con blanco cálido, controlado por la saturación. */
+    uint8_t pastel = SW_PASTEL_BASE + (uint8_t)(((uint16_t)(255 - rgb_matrix_config.hsv.s) * (SW_PASTEL_MAX - SW_PASTEL_BASE)) / 255);
+    uint8_t val    = rgb_matrix_config.hsv.v;
+
+    for (uint8_t i = led_min; i < led_max; i++) {
+        RGB_MATRIX_TEST_LED_FLAGS();
+
+        uint16_t pos = (uint16_t)(g_led_config.point[i].x * SW_SPREAD + g_led_config.point[i].y * SW_TILT);
+#if SW_LEFT_TO_RIGHT
+        pos -= t;
+#else
+        pos += t;
+#endif
+
+        /* Ubicar el tramo de la paleta y cuánto avanzamos dentro de él. */
+        uint32_t scaled = (uint32_t)pos * SW_STOPS;
+        uint8_t  seg    = (uint8_t)(scaled >> 16);
+        uint8_t  frac   = (uint8_t)((scaled >> 8) & 0xFF);
+        const uint8_t *a = SW_PALETTE[seg];
+        const uint8_t *b = SW_PALETTE[(seg + 1) % SW_STOPS];
+
+        uint8_t r = sw_lerp8(a[0], b[0], frac);
+        uint8_t g = sw_lerp8(a[1], b[1], frac);
+        uint8_t bl = sw_lerp8(a[2], b[2], frac);
+
+        r  = sw_lerp8(r, SW_WHITE_R, pastel);
+        g  = sw_lerp8(g, SW_WHITE_G, pastel);
+        bl = sw_lerp8(bl, SW_WHITE_B, pastel);
+
+        rgb_matrix_set_color(i, scale8(r, val), scale8(g, val), scale8(bl, val));
+    }
+    return rgb_matrix_check_finished_leds(led_max);
+}
+
+static bool SIGNALRGB(effect_params_t *params) {
+    RGB_MATRIX_USE_LIMITS(led_min, led_max);
+    return rgb_matrix_check_finished_leds(led_max);
+}
+
+#endif // RGB_MATRIX_CUSTOM_EFFECT_IMPLS
