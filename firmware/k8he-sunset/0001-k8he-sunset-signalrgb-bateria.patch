diff --git a/keyboards/keychron/k8_he/ansi/keymaps/sunset/signalrgb.c b/keyboards/keychron/k8_he/ansi/keymaps/sunset/signalrgb.c
new file mode 100644
index 0000000..8d1d682
--- /dev/null
+++ b/keyboards/keychron/k8_he/ansi/keymaps/sunset/signalrgb.c
@@ -0,0 +1,84 @@
+/* Protocolo SignalRGB 1.0.6, adaptado del módulo comunitario de SRGBmods
+ * (https://github.com/SRGBmods/QMK_Community_Module, GPL-2.0-or-later).
+ *
+ * Diferencias con el original:
+ *  - Se engancha en kc_raw_hid_rx_user() (firmware de Keychron) en vez de via_command_kb().
+ *  - Responde con kc_raw_hid_send() para respetar el origen del pedido.
+ *  - El modo "SignalRGB" es un efecto de rgb_matrix_user.inc (RGB_MATRIX_CUSTOM_SIGNALRGB).
+ *  - Solo atiende pedidos por cable, como el plugin. */
+#include QMK_KEYBOARD_H
+#include "signalrgb.h"
+#include "raw_hid.h"
+#include "keychron_raw_hid.h"
+
+static uint8_t packet[32];
+
+static void srgb_reply(uint8_t src, uint8_t command, uint8_t b1, uint8_t b2, uint8_t b3) {
+    memset(packet, 0, sizeof(packet));
+    packet[0] = command;
+    packet[1] = b1;
+    packet[2] = b2;
+    packet[3] = b3;
+    kc_raw_hid_send(src, packet, sizeof(packet));
+}
+
+static void srgb_stream(uint8_t src, uint8_t *data) {
+    uint8_t index = data[1];
+    uint8_t count = data[2];
+
+    if (index + count > RGB_MATRIX_LED_COUNT) {
+        srgb_reply(src, SRGB_STREAM_RGB_DATA, SRGB_DEVICE_ERROR_LED_BOUNDS, 0, 0);
+        return;
+    }
+    if (count >= 10) {
+        srgb_reply(src, SRGB_STREAM_RGB_DATA, SRGB_DEVICE_ERROR_LED_COUNT, 0, 0);
+        return;
+    }
+
+    for (uint8_t i = 0; i < count; i++) {
+        uint8_t offset = (i * 3) + 3;
+        uint8_t led    = index + i;
+
+#if defined(CAPS_LOCK_INDEX)
+        // Bloq Mayús encendido: la tecla queda blanca para no perder el indicador.
+        if (led == CAPS_LOCK_INDEX && host_keyboard_led_state().caps_lock) {
+            rgb_matrix_set_color(led, 255, 255, 255);
+            continue;
+        }
+#endif
+        rgb_matrix_set_color(led, data[offset], data[offset + 1], data[offset + 2]);
+    }
+}
+
+bool signalrgb_rx(uint8_t src, uint8_t *data, uint8_t length) {
+    if (data[0] < SRGB_GET_QMK_VERSION || data[0] > SRGB_GET_FIRMWARE_TYPE) return false;
+    if (src != RAW_HID_SRC_USB) return true;   // SignalRGB solo funciona por cable
+
+    switch (data[0]) {
+        case SRGB_GET_QMK_VERSION:
+            srgb_reply(src, data[0], SRGB_QMK_VERSION_BYTE_1, SRGB_QMK_VERSION_BYTE_2, SRGB_QMK_VERSION_BYTE_3);
+            break;
+        case SRGB_GET_PROTOCOL_VERSION:
+            srgb_reply(src, data[0], SRGB_PROTOCOL_VERSION_BYTE_1, SRGB_PROTOCOL_VERSION_BYTE_2, SRGB_PROTOCOL_VERSION_BYTE_3);
+            break;
+        case SRGB_GET_UNIQUE_IDENTIFIER:
+            srgb_reply(src, data[0], 0, 0, 0);
+            break;
+        case SRGB_STREAM_RGB_DATA:
+            srgb_stream(src, data);
+            break;
+        case SRGB_SET_MODE_ENABLE:
+            rgb_matrix_mode_noeeprom(RGB_MATRIX_CUSTOM_SIGNALRGB);
+            break;
+        case SRGB_SET_MODE_DISABLE:
+            rgb_matrix_reload_from_eeprom();   // vuelve al último efecto guardado
+            break;
+        case SRGB_GET_TOTAL_LEDS:
+            srgb_reply(src, data[0], RGB_MATRIX_LED_COUNT, 0, 0);
+            break;
+        case SRGB_GET_FIRMWARE_TYPE:
+            srgb_reply(src, data[0], SRGB_FIRMWARE_TYPE_BYTE, 0, 0);
+            break;
+    }
+    return true;
+}
diff --git a/keyboards/keychron/k8_he/ansi/keymaps/sunset/signalrgb.h b/keyboards/keychron/k8_he/ansi/keymaps/sunset/signalrgb.h
new file mode 100644
index 0000000..b236fa7
--- /dev/null
+++ b/keyboards/keychron/k8_he/ansi/keymaps/sunset/signalrgb.h
@@ -0,0 +1,35 @@
+/* Protocolo SignalRGB 1.0.6, adaptado del módulo comunitario de SRGBmods
+ * (https://github.com/SRGBmods/QMK_Community_Module, GPL-2.0-or-later)
+ * a la forma de despachar comandos raw HID del firmware de Keychron. */
+#pragma once
+
+#include <stdbool.h>
+#include <stdint.h>
+
+enum signalrgb_commands {
+    SRGB_GET_QMK_VERSION        = 0x21,
+    SRGB_GET_PROTOCOL_VERSION   = 0x22,
+    SRGB_GET_UNIQUE_IDENTIFIER  = 0x23,
+    SRGB_STREAM_RGB_DATA        = 0x24,
+    SRGB_SET_MODE_ENABLE        = 0x25,
+    SRGB_SET_MODE_DISABLE       = 0x26,
+    SRGB_GET_TOTAL_LEDS         = 0x27,
+    SRGB_GET_FIRMWARE_TYPE      = 0x28,
+};
+
+#define SRGB_PROTOCOL_VERSION_BYTE_1 1
+#define SRGB_PROTOCOL_VERSION_BYTE_2 0
+#define SRGB_PROTOCOL_VERSION_BYTE_3 6
+
+/* Versión de QMK informada (el plugin solo la muestra en su log). */
+#define SRGB_QMK_VERSION_BYTE_1 0
+#define SRGB_QMK_VERSION_BYTE_2 28
+#define SRGB_QMK_VERSION_BYTE_3 0
+
+/* 2 = firmware con VIA (el plugin hace una lectura extra por paquete). */
+#define SRGB_FIRMWARE_TYPE_BYTE 2
+
+#define SRGB_DEVICE_ERROR_LED_BOUNDS 253
+#define SRGB_DEVICE_ERROR_LED_COUNT 254
+
+bool signalrgb_rx(uint8_t src, uint8_t *data, uint8_t length);
