diff --git a/keyboards/keychron/k8_he/ansi/keymaps/sunset/battery_hid.c b/keyboards/keychron/k8_he/ansi/keymaps/sunset/battery_hid.c
new file mode 100644
index 0000000..e7b80be
--- /dev/null
+++ b/keyboards/keychron/k8_he/ansi/keymaps/sunset/battery_hid.c
@@ -0,0 +1,40 @@
+#include "quantum.h"
+#include "battery_hid.h"
+#include "keychron_raw_hid.h"
+#include "battery.h"
+#include "transport.h"
+#include "lpm.h"
+
+bool battery_hid_rx(uint8_t src, uint8_t *data, uint8_t length) {
+    if (data[0] != BATTERY_HID_CMD) return false;
+
+    memset(&data[1], 0, length - 1);
+
+    uint8_t flags = 0;
+    if (usb_power_connected()) {
+        flags |= BATTERY_HID_FLAG_USB_POWER;
+#if defined(BAT_CHARGING_PIN)
+        // Misma lógica que battery_task(): con USB, pin activo = cargando; si no, carga completa.
+        if (gpio_read_pin(BAT_CHARGING_PIN) == BAT_CHARGING_LEVEL)
+            flags |= BATTERY_HID_FLAG_CHARGING;
+        else
+            flags |= BATTERY_HID_FLAG_FULL;
+#endif
+    }
+
+    // El chip inalámbrico mide el voltaje periódicamente solo en modo inalámbrico. Por cable
+    // queda el último valor (o el de arranque), así que se marca como no vigente.
+    transport_t transport = get_transport();
+    if ((transport & TRANSPORT_WIRELESS) && !battery_power_on_sample()) flags |= BATTERY_HID_FLAG_MEASURED;
+
+    uint16_t mv = battery_get_voltage();
+    data[1]     = BATTERY_HID_VERSION;
+    data[2]     = battery_get_percentage();
+    data[3]     = flags;
+    data[4]     = mv & 0xFF;
+    data[5]     = mv >> 8;
+    data[6]     = (uint8_t)transport;
+
+    kc_raw_hid_send(src, data, length);
+    return true;
+}
diff --git a/keyboards/keychron/k8_he/ansi/keymaps/sunset/battery_hid.h b/keyboards/keychron/k8_he/ansi/keymaps/sunset/battery_hid.h
new file mode 100644
index 0000000..d08aa11
--- /dev/null
+++ b/keyboards/keychron/k8_he/ansi/keymaps/sunset/battery_hid.h
@@ -0,0 +1,26 @@
+#pragma once
+
+#include <stdbool.h>
+#include <stdint.h>
+
+/* Comando raw HID de batería (solo lectura), para BatteryTray.
+ *
+ * Pedido (32 bytes):  [0] = 0xBA
+ * Respuesta:          [0] = 0xBA
+ *                     [1] = versión del formato (1)
+ *                     [2] = porcentaje 0-100
+ *                     [3] = flags: bit0 cargando, bit1 carga completa, bit2 USB con energía,
+ *                                  bit3 medición vigente (el voltaje solo se mide en modo inalámbrico)
+ *                     [4..5] = voltaje de la batería en mV (little endian)
+ *                     [6] = transporte actual (1 = USB, 2 = Bluetooth, 4 = 2.4 GHz)
+ *
+ * Funciona por cable y, con WILRESS_RAW_ENABLE, a través del receptor Keychron Link. */
+#define BATTERY_HID_CMD 0xBA
+#define BATTERY_HID_VERSION 1
+
+#define BATTERY_HID_FLAG_CHARGING 0x01
+#define BATTERY_HID_FLAG_FULL 0x02
+#define BATTERY_HID_FLAG_USB_POWER 0x04
+#define BATTERY_HID_FLAG_MEASURED 0x08
+
+bool battery_hid_rx(uint8_t src, uint8_t *data, uint8_t length);
